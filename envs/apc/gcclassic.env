#==============================================================================
# Load GEOS-Chem Classic environment on AWS ParallelCluster (IMI dependency
# AMI, which installs gcc 12.2.0, netCDF, NCO, CMake and OpenMPI under
# /opt/imi). Use a repo-relative path in the config:
#   GEOSChemEnv: "envs/apc/gcclassic.env"
#==============================================================================
source /opt/imi/geoschem.env
