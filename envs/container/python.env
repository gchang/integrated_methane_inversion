#==============================================================================
# Load Python environment for the IMI container image
# (micromamba environment "imi_env" from the base image)
#==============================================================================
printf "\nActivating micromamba environment: imi_env\n"
export MAMBA_EXE=/home/ubuntu/bin/micromamba
export MAMBA_ROOT_PREFIX=/home/ubuntu/micromamba
eval "$("$MAMBA_EXE" shell hook --shell bash)"
micromamba activate imi_env
